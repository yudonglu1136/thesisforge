thesisforge.tech {
  redir https://www.thesisforge.tech{uri} permanent
}

www.thesisforge.tech {
  encode zstd gzip

  handle /api/* {
    reverse_proxy http://thesisforge-api-prod-378477120101.us-east-1.elasticbeanstalk.com {
      header_up -Origin
      header_up Host thesisforge-api-prod-378477120101.us-east-1.elasticbeanstalk.com
    }
  }

  handle {
    root * /var/snap/caddy/common/www/thesisforge

    header /index.html Cache-Control "no-cache, must-revalidate"
    header /flutter_bootstrap.js Cache-Control "no-cache, must-revalidate"
    header /flutter_service_worker.js Cache-Control "no-cache, must-revalidate"
    header /main.dart.js Cache-Control "no-cache, must-revalidate"
    header /version.json Cache-Control "no-cache, must-revalidate"

    try_files {path} /index.html
    file_server
  }
}

api.thesisforge.tech {
  # Keep this boundary aligned with server/retiredProductRoutes.js. Match
  # whole path segments, including case variants, without retiring the new
  # /api/investment/* strategies, Value Flow, valuation or Guru endpoints.
  @retired_product path_regexp retired_product (?i)^/(ontology-health/*|api/((ontology|dbmf|strategies|decision|market)(/.*)?|(overview|graph|methodology|timeline|rankings|snapshot)/*|company/[^/]+/*))$
  handle @retired_product {
    header Cache-Control "no-store"
    header Content-Type "application/json"
    respond `{"error":"module_retired"}` 410
  }

  handle {
    reverse_proxy 127.0.0.1:8787
  }
}
