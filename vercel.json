{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bash scripts/vercel-install.sh",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/research/isrg$",
      "status": 308,
      "headers": { "Location": "/research/isrg/" }
    },
    {
      "src": "^/research/isrg/.*$",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate", "X-Content-Type-Options": "nosniff" },
      "continue": true
    },
    {
      "src": "^/research/isrg/$",
      "dest": "/research/isrg/index.html"
    },
    {
      "src": "^/$",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/(index\\.html|refresh\\.html|main\\.dart\\.js|thesisforge-build\\.json|flutter_bootstrap\\.js|flutter_service_worker\\.js)$",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/guru-avatars/[^/]+\\.png$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/stock-logos/[^/]+\\.png$",
      "headers": { "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800", "X-Content-Type-Options": "nosniff" },
      "continue": true
    },
    {
      "src": "^/(favicon\\.(?:png|ico)|manifest\\.json|icons/[^/]+\\.png|brand/[^/]+\\.png)$",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "^/(ontology|dbmf)(?:/.*)?$",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "X-Content-Type-Options": "nosniff"
      },
      "dest": "/index.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/proxy.js?path=/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
