# Production frontend
VITE_AUTH_PROVIDER=supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-production-supabase-anon-key
# Leave empty on Vercel so the Flutter app calls same-origin /api/*.
VITE_AUTH_DEV_BYPASS=false

# Vercel serverless API proxy target.
AWS_API_ORIGIN=https://backend.thesisforge.tech
ONTOLOGY_API_ORIGIN=https://api.thesisforge.tech

# Production backend
NODE_ENV=production
PORT=8787
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-production-supabase-anon-key
SUPABASE_JWT_SECRET=your-production-supabase-jwt-secret
API_ALLOWED_ORIGINS=https://your-frontend-domain.com
API_AUTH_DEV_BYPASS=false
# Elastic Beanstalk verifies the separately deployed Ontology read service here.
ONTOLOGY_HEALTH_URL=https://api.thesisforge.tech/ontology-health
ONTOLOGY_SNAPSHOT_PATH=server/data/ontology-snapshot.sqlite

# One-time Guru price-repair release inputs. Leave all unset during normal
# operation; the postdeploy hook runs only when the complete set is supplied.
# GURU_PRICE_REPAIR_S3_URI=s3://thesisforge-production-378477120101-us-east-1/guru-price-repairs/guru-curves-release.json.gz
# GURU_PRICE_REPAIR_SHA256=<compressed-artifact-sha256>
# GURU_PRICE_REPAIR_SNAPSHOT_ID=snap-<fresh-source-snapshot>
# GURU_PRICE_REPAIR_ENCRYPTED_SNAPSHOT_ID=snap-<encrypted-rollback-copy>
# GURU_PRICE_REPAIR_SOURCE_VOLUME_ID=vol-<current-production-root-volume>
# GURU_PRICE_REPAIR_RELEASE_ID=guru-curves-<release-id>
# GURU_PRICE_REPAIR_OPERATOR=eb-postdeploy
# Optional per-window overall loopback timeout; defaults to 25 minutes and is
# capped at 30 minutes. Elastic Beanstalk's deployment command timeout is 60m.
# GURU_PREWARM_REFRESH_TIMEOUT_MS=1500000
