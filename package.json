{
  "name": "thesisforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run server\" \"npm run client\"",
    "client": "bash scripts/flutter-dev.sh",
    "server": "bash scripts/local-server-dev.sh",
    "hydrate:db": "node server/hydrateDatabase.js",
    "import:strategy:db": "node scripts/import-strategy-database.mjs",
    "import:hedge": "node scripts/import-hedge-data.mjs",
    "sync:hedge": "node scripts/sync-hedge-polygon.mjs",
    "test:hedge": "node --test server/hedgeLab.test.js server/strategyHedge.test.js server/strategyLabRoutes.test.js",
    "verify:strategy:db": "node scripts/verify-strategy-database.mjs",
    "verify:strategy:population": "node scripts/verify-strategy-population.mjs",
    "verify:strategy:matrix": "node scripts/verify-strategy-full-matrix.mjs",
    "test:strategy:matrix": "node --test scripts/strategy-regression-matrix.test.mjs server/strategyLab.matrix.test.js",
    "test:strategy:db": "node --test server/strategyDatabase.test.js server/strategyLab.test.js server/strategyLabRoutes.test.js server/strategyFilings.test.js",
    "install:avatars": "node server/installGuruAvatars.js",
    "import:youtube-valuations": "node server/importYoutubeEarningsValuations.js",
    "import:stockinsights-transcripts": "node server/importStockInsightsTranscripts.js",
    "import:sec-quarterly-valuations": "node server/importSecQuarterlyValuations.js",
    "import:derived-valuations": "node server/importDerivedValuationTickers.js",
    "enrich:valuation-transcript-qa": "node server/enrichValuationTranscriptQa.js",
    "refresh:dividends": "node server/refreshDividendCalendar.js",
    "refresh:13f": "node server/refreshThirteenF.js",
    "build:research": "node scripts/build-public-research.mjs",
    "build:production-research": "node scripts/build-production-research-db.mjs",
    "test:research": "node --test scripts/public-research.test.mjs scripts/export-isrg-public-case.test.mjs && node scripts/build-public-research.mjs --check",
    "test:proxy": "node --test server/apiProxy.test.js",
    "test:launch-prep": "node --test server/apiProxy.test.js server/asyncUserCache.test.js server/userPortfolioHandles.test.js server/portfolioHttp.test.js scripts/check-production-source.test.mjs scripts/isolated-flutter-build.test.mjs scripts/thesisforge-bootstrap.test.mjs",
    "test:user-data": "node --test server/userDataPaths.test.js server/userDataBackup.test.js server/userPortfolioHandles.test.js server/loginActivity.test.js server/investmentWorkflow.test.js scripts/user-data-operations.test.mjs",
    "user-data": "node scripts/user-data-maintenance.mjs",
    "db:audit": "node scripts/database-release-audit.mjs",
    "test:database-release": "node --test scripts/database-release-audit.test.mjs scripts/audit-aws-database-host.test.mjs scripts/check-production-source.test.mjs server/localDatabaseSync.test.js server/userDataBackup.test.js",
    "test:server": "node --test server/*.test.js",
    "test:performance": "node --test server/apiProxy.test.js server/jsonTransport.test.js server/publicHealthService.test.js server/publicHealthWorker.test.js server/valuationClient.summary.test.js scripts/static-performance-budget.test.mjs scripts/performance-tools.test.mjs",
    "bench:api": "node scripts/benchmark-api.mjs",
    "bench:13f": "node scripts/benchmark-13f-insights.mjs",
    "bench:fundamental": "node scripts/benchmark-fundamental-research.mjs",
    "bench:bundle": "node scripts/benchmark-bundle.mjs",
    "summarize:performance": "node scripts/summarize-performance-runs.mjs",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "sync:youtube-transcripts": "python3 scripts/sync_youtube_transcripts.py",
    "refresh:podcast-insights": "node server/generatePodcastValuationInsights.js",
    "audit:valuation": "node server/unifiedValuationAudit.js",
    "audit:valuation:qa": "node server/valuationQaReport.js",
    "audit:valuation:ledger": "node server/valuationAuditLedger.js",
    "audit:valuation:refresh": "VALUATION_CONSENSUS_REFRESH=1 node server/unifiedValuationAudit.js",
    "audit:pit-release": "node server/verifyPitValuationRelease.js",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "build:pit-migration": "python3 scripts/build-pit-migration-artifact.py",
    "build": "bash scripts/flutter-build.sh",
    "package:aws": "bash scripts/package-aws-backend.sh",
    "start": "NODE_ENV=production node server/index.js",
    "import:valuation-aliases": "node server/importValuationAliases.js",
    "fact-os:status": "bash bin/fact-os status",
    "fact-os:sync": "bash bin/fact-os sync",
    "audit:fact-os": ".venv-fact-os/bin/python scripts/audit-fact-os.py --sqlite-inventory --full --offline-probes --require-complete",
    "audit:fact-os-storage": ".venv-fact-os/bin/python scripts/audit-fact-os-storage.py --root data/fact_os --output data/fact_os/audit/storage-layout-latest.json",
    "audit:storage-layout": "node scripts/audit-storage-layout.mjs"
  },
  "dependencies": {
    "concurrently": "^10.0.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.2.5"
  }
}
